# Local development only. Production secrets belong in Render, never Git.
FLASK_ENV=development
FLASK_DEBUG=False
OAP_LOCAL_MODE=true
PORT=5000

# Generate a unique value locally; do not copy this placeholder into production.
OAP_SESSION_SECRET=replace-with-a-random-64-byte-value

# Neon pooled connection string for production. Leave empty for explicit local mode.
DATABASE_URL=

# Branch-specific Managed Neon Auth base URL (non-secret).
# Keep the private-route assertion enabled in every deployed environment.
NEON_AUTH_BASE_URL=
OAP_AUTH_REQUIRED=true

# SMI provider configuration. Keep the actual key outside source control.
OPENAI_API_KEY=
OAP_AI_PROVIDER=openai
OAP_AI_MODEL=gpt-5-mini
OAP_CHAT_RATE_LIMIT=12

# Human Authority must explicitly approve registry activation.
OAP_AGENT_REGISTRY_APPROVED=false

# Human Authority binds only to an exact verified Neon identity. Prefer the
# UUID selector after account creation; verified email is a safe bootstrap.
OAP_HUMAN_AUTHORITY_ID=
OAP_HUMAN_AUTHORITY_EMAIL=
OAP_APPROVAL_SIGNING_KEY=

# Optional agentless Datadog metric delivery from Render.
OAP_DATADOG_ENABLED=false
DD_SITE=datadoghq.eu
DD_API_KEY=
DD_SERVICE=on-any-postcode
DD_ENV=production

# Non-secret recovery reference shown by infrastructure probes.
OAP_RECOVERY_CHECKPOINT=
