    {"name": "The Spot", "short_name": "The Spot", "description": "Enter the local postcode community.", "url": "/the-spot?source=oap-os-shortcut", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "OAP Atlas", "short_name": "Atlas", "description": "Open places, attractions, weather signals and movement entry.", "url": "/the-spot/maps-weather-travel?source=oap-os-shortcut", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "OAP Direct", "short_name": "Direct", "description": "Open Direct listings, attractions, stays and requests.", "url": "/travel/direct?source=oap-os-shortcut", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "The Link", "short_name": "The Link", "description": "Open the OAP communications gateway.", "url": "/the-link?source=oap-os-shortcut", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "Movement", "short_name": "Movement", "description": "Open OAP movement and travel.", "url": "/movement?source=oap-os-shortcut", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "Market", "short_name": "Market", "description": "Open local listings and creator commerce.", "url": "/the-spot/market?source=oap-os-shortcut", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]}
  ]
