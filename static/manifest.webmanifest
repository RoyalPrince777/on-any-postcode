{
  "name": "ON ANY POSTCODE Operating System",
  "short_name": "OAP OS",
  "description": "The public install shell for ON ANY POSTCODE.",
  "id": "/",
  "start_url": "/?source=oap-os",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#050807",
  "theme_color": "#050807",
  "prefer_related_applications": false,
  "launch_handler": {"client_mode": "navigate-existing"},
  "categories": ["social", "lifestyle", "utilities", "travel"],
  "icons": [
    {"src": "/assets/oap-os-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/assets/oap-os-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "The Spot", "short_name": "Spot", "url": "/the-spot?source=oap-os", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "The Link", "short_name": "Link", "url": "/the-link?source=oap-os", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "Link Up", "short_name": "Link Up", "url": "/linkup?source=oap-os", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]},
    {"name": "Movement", "short_name": "Move", "url": "/movement?source=oap-os", "icons": [{"src": "/assets/oap-os-icon-192.png", "sizes": "192x192"}]}
  ]
}
