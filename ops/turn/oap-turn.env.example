# Copy to /etc/oap-turn/oap-turn.env on the OAP-controlled relay host.
# Keep the real file root-owned and mode 0600. Never commit the real secret.

OAP_TURN_REALM=turn.example.invalid
OAP_TURN_EXTERNAL_IP=203.0.113.10
OAP_TURN_SHARED_SECRET=REPLACE_WITH_64_CHAR_BASE64URL_SECRET
OAP_TURN_CERT=/etc/letsencrypt/live/turn.example.invalid/fullchain.pem
OAP_TURN_PKEY=/etc/letsencrypt/live/turn.example.invalid/privkey.pem
